        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "influx-sensor"
            },
            "query": "from(bucket: \"sensor\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"flags\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> last()"
          }
        ],

      {
        "id": 8,
        "type": "table",
        "title": "Alarm / olay geçmişi",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-sensor"
        },
        "gridPos": {
          "x": 0,
          "y": 43,
          "w": 24,
          "h": 10
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "influx-sensor"
            },
            "query": "from(bucket: \"sensor\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"event\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"code\", \"state\", \"value\", \"limit\", \"desc\"])\n  |> sort(columns: [\"_time\"], desc: true)"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "indexByName": {
                "_time": 0,
                "code": 1,
                "state": 2,
                "value": 3,
                "limit": 4,
                "desc": 5
              },
              "renameByName": {
                "_time": "Zaman",
                "code": "Kod",
                "state": "Durum",
                "value": "Değer",
                "limit": "Limit",
                "desc": "Açıklama"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "left"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Durum"
              },
              "properties": [
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "BASLADI": {
                          "text": "Başladı",
                          "color": "red"
                        },
                        "BITTI": {
                          "text": "Bitti",
                          "color": "green"
                        },
                        "BILGI": {
                          "text": "Bilgi",
                          "color": "blue"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-text"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Zaman"
              },
              "properties": [
                {

      {
        "id": 9,
        "type": "timeseries",
        "title": "Anomali skoru (z, duruş titreşimine göre)",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-sensor"
        },
        "gridPos": {
          "x": 0,
          "y": 28,
          "w": 24,
          "h": 8
        },
        "description": "ESP32 üzerinde hesaplanır: (v - öğrenilen duruş ortalaması) / sigma. 4 üstü: duruşta anormal titreşim adayı, 6 üstü: hareket (sefer).",
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "influx-sensor"
            },
            "query": "from(bucket: \"sensor\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and (r._field == \"az\"))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "min": 0,
            "color": {
              "mode": "fixed",
              "fixedColor": "blue"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 4
                },
                {
                  "color": "red",
                  "value": 6
                }
              ]
            },
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10,
              "showPoints": "never",
              "spanNulls": 30000,
              "thresholdsStyle": {
                "mode": "line+area"
              }
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "az"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "z-skoru"
                }
              ]
            }
          ]
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        }
      },

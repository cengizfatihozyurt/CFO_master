{
  "dashboard": {
    "uid": "stm32iot",
    "title": "STM32 IoT Sensör İzleme",
    "tags": [
      "stm32",
      "iot",
      "mqtt"
    ],
    "timezone": "browser",
    "refresh": "5s",
    "schemaVersion": 39,
    "editable": true,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m"
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Sıcaklık (son)",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-sensor"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "influx-sensor"
            },
            "query": "from(bucket: \"sensor\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"temp\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> last()"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 40
                },
                {
                  "color": "red",
                  "value": 60
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value",
          "justifyMode": "center"
        }
      },
      {

      {
        "id": 4,
        "type": "stat",
        "title": "Son veri",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-sensor"
        },
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "influx-sensor"
            },
            "query": "from(bucket: \"sensor\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"v\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: uint(v: now()) - uint(v: r._time)) / 1000000000.0}))"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value",
          "justifyMode": "center"
        },
        "description": "Son ölçümden bu yana geçen süre. 10 saniyeyi aşarsa veri akışı durmuş demektir."
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Sıcaklık",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-sensor"
        },
        "gridPos": {
          "x": 0,
          "y": 5,
          "w": 24,
          "h": 9
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "influx-sensor"
            },
            "query": "from(bucket: \"sensor\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and (r._field == \"temp\" or r._field == \"tset\"))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "decimals": 2,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 8,
              "showPoints": "never",
              "spanNulls": 30000
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "temp"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Sıcaklık"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "tset"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Sıcaklık seti"
                }
              ]
            }
          ]
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      },

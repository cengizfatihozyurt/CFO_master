    {
        "id": "f_setcmd",
        "type": "function",
        "z": "tab_stm32iot",
        "name": "Set komutu",
        "func": "const p = msg.payload || {};\nconst t = Number(p.tset), v = Number(p.vset), li = Math.round(Number(p.logint));\nconst err = [];\nif (!(t >= -55 && t <= 125)) err.push('sıcaklık -55..125 °C olmalı');\nif (!(v >= 0.001 && v <= 16)) err.push('titreşim 0.001..16 g olmalı');\nif (!(li >= 1 && li <= 3600)) err.push('kayıt aralığı 1..3600 s olmalı');\nif (err.length) return [null, {payload: 'Gönderilmedi: ' + err.join(', ')}];\nreturn [\n    {payload: JSON.stringify({tset: t, vset: v, logint: li})},\n    {payload: 'Set değerleri cihaza gönderildi'},\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,

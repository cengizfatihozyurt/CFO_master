    {
        "id": "f_event",
        "type": "function",
        "z": "tab_stm32iot",
        "name": "Olay kaydı",
        "func": "const e = msg.payload;\nif (typeof e !== 'object' || e === null) return null;\n\nconst ts = e.ts ? e.ts * 1000 : Date.now();\nconst zaman = new Date(ts).toLocaleString('tr-TR', {timeZone: 'Europe/Istanbul'});\nconst STATE = {BASLADI: 'Başladı', BITTI: 'Bitti', BILGI: 'Bilgi'};\nconst dec = e.code === 'E01' ? 2 : 3;\nconst fmt = v => (v === null || v === undefined) ? '-' : Number(v).toFixed(dec);\n\nconst row = {\n    'Zaman': zaman,\n    'Kod': e.code,\n    'Durum': STATE[e.state] || e.state,\n    'Değer': fmt(e.value),\n    'Limit': fmt(e.limit),\n    'Açıklama': e.desc,\n};\nconst list = flow.get('events') || [];\nlist.unshift(row);\nif (list.length > 200) list.length = 200;\nflow.set('events', list);\n\nlet note = null;\nif (e.state === 'BASLADI') {\n    note = {payload: `${e.code} ${e.desc} (değer ${fmt(e.value)}, limit ${fmt(e.limit)}) - ${zaman}`};\n}\n\nconst dir = path.join(os.homedir(), 'stm32iot_kayit');\nconst filename = path.join(dir, 'olaylar.csv');\nlet header = fs.existsSync(filename) ? '' : 'zaman;kod;durum;deger;limit;aciklama\\n';\nconst num = v => (v === null || v === undefined) ? '' : String(v).replace('.', ',');\nconst line = header + [zaman, e.code, e.state, num(e.value), num(e.limit), e.desc].join(';');\n\nreturn [{payload: list}, note, {payload: line, filename: filename}];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "fs",
                "module": "fs"
            },
            {
                "var": "os",
                "module": "os"
            },
            {
                "var": "path",
                "module": "path"
            }
        ],
        "x": 600,

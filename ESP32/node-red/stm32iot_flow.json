    {
        "id": "f_influx_status",
        "type": "function",
        "z": "tab_stm32iot",
        "name": "InfluxDB durumu",
        "func": "const ok = msg.statusCode >= 200 && msg.statusCode < 300;\nconst t = new Date().toLocaleTimeString('tr-TR', {timeZone: 'Europe/Istanbul'});\nif (ok) {\n    node.status({fill: 'green', shape: 'dot', text: 'yazıldı ' + t});\n} else {\n    node.status({fill: 'red', shape: 'ring', text: 'HATA ' + (msg.statusCode || 'bağlantı yok') + ' ' + t});\n    node.warn('InfluxDB yazma hatası: ' + msg.statusCode + ' ' + String(msg.payload).slice(0, 200));\n}\nreturn null;\n",
        "outputs": 0,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

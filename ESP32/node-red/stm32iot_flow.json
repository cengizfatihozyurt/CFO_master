    {
        "id": "f_influx_tel",
        "type": "function",
        "z": "tab_stm32iot",
        "name": "InfluxDB satırı (telemetri)",
        "func": "function influxMsg(msg, line) {\n    msg.method = 'POST';\n    msg.url = env.get('INFLUX_URL') + '/api/v2/write?org=' + encodeURIComponent(env.get('INFLUX_ORG'))\n            + '&bucket=' + encodeURIComponent(env.get('INFLUX_BUCKET')) + '&precision=s';\n    msg.headers = {'Authorization': 'Token ' + env.get('INFLUX_TOKEN'), 'Content-Type': 'text/plain; charset=utf-8'};\n    msg.payload = line;\n    return msg;\n}\nconst parts = String(msg.topic || '').split('/');\nconst device = (parts.length >= 2 ? parts[parts.length - 2] : 'cihaz01').replace(/[ ,=]/g, '_');\n\n// ESP32 telemetrisi -> InfluxDB satir protokolu (measurement: telemetry)\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\nconst ts = d.ts ? Math.floor(d.ts) : Math.floor(Date.now() / 1000);   // NTP yoksa ts=0 gelir\nconst f = [];\nconst add = (k, v) => { if (typeof v === 'number' && isFinite(v)) f.push(k + '=' + v); };\nadd('temp', d.temp);\nadd('vx', d.vx); add('vy', d.vy); add('vz', d.vz); add('v', d.v);\nadd('tset', d.tset); add('vset', d.vset);\nconst flags = Number(d.flags) || 0;\nadd('flags', flags);\nadd('alarm_temp', (flags & 0x01) ? 1 : 0);\nadd('alarm_vib', (flags & 0x02) ? 1 : 0);\nadd('alarm_sensor', (flags & 0x04) ? 1 : 0);\nadd('alarm_link', (flags & 0x08) ? 1 : 0);\n// Uc birim anomali tespiti (ESP32 FW 1.4+): mod (0 ogreniyor, 1 durus, 2 hareket), z-skoru, A01-A04\nadd('ast', d.ast); add('az', d.az);\nadd('anom_shock', (flags & 0x10) ? 1 : 0);\nadd('anom_idle', (flags & 0x20) ? 1 : 0);\nadd('anom_ride', (flags & 0x40) ? 1 : 0);\nadd('anom_temp', (flags & 0x80) ? 1 : 0);\nif (!f.length) return null;\nreturn influxMsg(msg, 'telemetry,device=' + device + ' ' + f.join(',') + ' ' + ts);\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 220,
        "y": 840,
        "wires": [
            [
                "http_influx"
            ]
        ]
    },
    {
        "id": "f_influx_evt",
        "type": "function",
        "z": "tab_stm32iot",
        "name": "InfluxDB satırı (olay)",
        "func": "function influxMsg(msg, line) {\n    msg.method = 'POST';\n    msg.url = env.get('INFLUX_URL') + '/api/v2/write?org=' + encodeURIComponent(env.get('INFLUX_ORG'))\n            + '&bucket=' + encodeURIComponent(env.get('INFLUX_BUCKET')) + '&precision=s';\n    msg.headers = {'Authorization': 'Token ' + env.get('INFLUX_TOKEN'), 'Content-Type': 'text/plain; charset=utf-8'};\n    msg.payload = line;\n    return msg;\n}\nconst parts = String(msg.topic || '').split('/');\nconst device = (parts.length >= 2 ? parts[parts.length - 2] : 'cihaz01').replace(/[ ,=]/g, '_');\n\n// ESP32 olayi -> InfluxDB (measurement: event)\nconst e = msg.payload;\nif (typeof e !== 'object' || e === null) return null;\nconst ts = e.ts ? Math.floor(e.ts) : Math.floor(Date.now() / 1000);\nconst str = s => '\"' + String(s === undefined || s === null ? '' : s).replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"') + '\"';\nconst f = ['code=' + str(e.code), 'state=' + str(e.state), 'desc=' + str(e.desc)];\nif (typeof e.value === 'number' && isFinite(e.value)) f.push('value=' + e.value);\nif (typeof e.limit === 'number' && isFinite(e.limit)) f.push('limit=' + e.limit);\nreturn influxMsg(msg, 'event,device=' + device + ',ecode=' + String(e.code).replace(/[ ,=]/g, '_') + ' ' + f.join(',') + ' ' + ts);\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 220,
        "y": 880,
        "wires": [
            [
                "http_influx"
            ]
        ]
    },

    {
        "id": "f_route",
        "type": "function",
        "z": "tab_stm32iot",
        "name": "Konuya göre ayır",
        "func": "// <onek>/<yaprak> -> cikis\nconst leaf = msg.topic.split('/').pop();\nconst idx = {telemetry: 0, event: 1, status: 2, settings: 3, info: 4}[leaf];\nif (idx === undefined) return null;\nconst out = [null, null, null, null, null];\nout[idx] = msg;\nreturn out;",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 260,
        "wires": [
            [
                "f_telemetry",
                "trig_live",
                "f_influx_tel"
            ],
            [
                "f_event",
                "f_influx_evt"
            ],
            [
                "f_status"
            ],
            [
                "f_settings"
            ],
            [
                "f_info"
            ]
        ]
    },
    {
        "id": "f_telemetry",
        "type": "function",
        "z": "tab_stm32iot",
        "name": "Telemetri",
        "func": "const d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\n\nconst ts = d.ts ? d.ts * 1000 : Date.now();\nconst zaman = new Date(ts).toLocaleString('tr-TR', {timeZone: 'Europe/Istanbul'});\nconst alarms = (d.alarms || []);\nconst tempTxt = d.temp === null ? 'HATA' : d.temp.toFixed(2);\n\nconst tempSeries = [];\nif (d.temp !== null) tempSeries.push({topic: 'Sıcaklık (°C)', payload: d.temp});\ntempSeries.push({topic: 'Set', payload: d.tset});\n\nconst vibSeries = [\n    {topic: 'Toplam (g)', payload: d.v},\n    {topic: 'X', payload: d.vx},\n    {topic: 'Y', payload: d.vy},\n    {topic: 'Z', payload: d.vz},\n    {topic: 'Set', payload: d.vset},\n];\n\nconst MODES = ['Öğreniyor', 'Duruş', 'Hareket'];\nconst anomCodes = alarms.filter(c => c[0] === 'A');\nconst anomTxt = d.ast === undefined ? '-'\n    : MODES[d.ast] + (d.ast > 0 ? '  ·  z = ' + Number(d.az).toFixed(1) : '')\n      + (anomCodes.length ? '  ·  ANOMALİ: ' + anomCodes.join(', ') : '');\n\nconst alarmTxt = alarms.length ? 'AKTİF: ' + alarms.join(', ') : 'Yok';\n\n// Gunluk CSV kaydi (Node-RED kullanici klasoru altinda)\nconst day = new Date(ts).toLocaleDateString('sv-SE', {timeZone: 'Europe/Istanbul'});\nconst dir = path.join(os.homedir(), 'stm32iot_kayit');\nconst filename = path.join(dir, day + '.csv');\nlet header = '';\nif (flow.get('csvFile') !== filename) {\n    flow.set('csvFile', filename);\n    if (!fs.existsSync(filename)) header = 'zaman;sicaklik_C;titresim_x_g;titresim_y_g;titresim_z_g;titresim_toplam_g;alarmlar\\n';\n}\nconst num = v => (v === null || v === undefined) ? '' : String(v).replace('.', ',');\nconst line = header + [zaman, num(d.temp), num(d.vx), num(d.vy), num(d.vz), num(d.v), alarms.join(' ')].join(';');\n\nreturn [\n    {payload: d.temp === null ? 0 : d.temp},\n    {payload: d.v},\n    tempSeries,   // dizi: ayni cikistan birden fazla mesaj\n    vibSeries,\n    {payload: tempTxt + ' °C  /  ' + d.v.toFixed(3) + ' g'},\n    {payload: alarmTxt},\n    {payload: zaman},\n    {payload: line, filename: filename},\n    {payload: anomTxt},\n];",
        "outputs": 9,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "fs",
                "module": "fs"
            },
            {
                "var": "os",
                "module": "os"
            },
            {
                "var": "path",
                "module": "path"
            }
        ],

# Bulut MQTT koprusu: HiveMQ Cloud (TLS 8883) <-> yerel Mosquitto
# ESP32 dogrudan HiveMQ Cloud'a baglanir (her agdan); kopru cihaz mesajlarini buluttan
# yerele alir (Node-RED / InfluxDB / Grafana icin), yereldeki set komutlarini buluta iletir.
# Not: HiveMQ Cloud Serverless 31.12.2026'da kapanir; oncesinde EMQX'e tasinmali.
connection hivemq_bulut
address c6b99409cd8f46a382ca6eba365ebbfb.s1.eu.hivemq.cloud:8883
bridge_protocol_version mqttv311
bridge_cafile C:\ProgramData\STM32IoT\mosquitto\isrg_root_x1.pem
bridge_insecure false
remote_clientid stm32iot-kopru-pc
remote_username stm32iot-kopru
remote_password HIVEMQ_SIFRESI
try_private false
notifications false
cleansession false
keepalive_interval 60
restart_timeout 10 60

# Bulut -> yerel (cihaz mesajlari)
topic stm32iot-fa6dbb/cihaz01/telemetry in 0
topic stm32iot-fa6dbb/cihaz01/event in 1
topic stm32iot-fa6dbb/cihaz01/status in 1
topic stm32iot-fa6dbb/cihaz01/info in 1
topic stm32iot-fa6dbb/cihaz01/settings in 1
topic stm32iot-fa6dbb/cihaz01/anomaly in 0
# Yerel -> bulut (Node-RED panelinden set ve anomali komutlari)
topic stm32iot-fa6dbb/cihaz01/settings/set out 1
